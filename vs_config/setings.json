{
  // ========== TEMA & UI ==========
  "workbench.colorTheme": "One Dark Pro Darker",
  "workbench.preferredLightColorTheme": "Default Dark Modern",
  "workbench.preferredDarkColorTheme": "Palenight (Mild Contrast)",
  "workbench.iconTheme": "vscode-icons",
  "workbench.startupEditor": "newUntitledFile",
  "workbench.activityBar.location": "bottom",
  "workbench.statusBar.visible": false,
  "workbench.secondarySideBar.defaultVisibility": "hidden",
  "window.autoDetectColorScheme": true,
  "editor.colorDecorators": true,
  // Customizações de cores adicionais (seleçaõ de texto)
  "workbench.colorCustomizations": {
    "editor.selectionBackground": "#0f41c9d8",
    "editor.selectionHighlightBackground": "#070c1150",
    "editor.linkedEditingBackground": "#0a0f09d8"
  },
  // ========== UI MINIMALISTA ==========
  "breadcrumbs.enabled": false,
  "editor.minimap.enabled": false,
  "editor.scrollbar.horizontal": "hidden",
  "editor.scrollbar.vertical": "hidden",
  "editor.overviewRulerBorder": false,
  "editor.hideCursorInOverviewRuler": false,
  "editor.renderWhitespace": "selection",
  // ========== CONFIGURAÇÃO DO EDITOR ==========
  "editor.fontSize": 13,
  "editor.lineHeight": 1.8,
  "editor.fontFamily": "'JetBrains Mono', 'Fira Code', Menlo, Monaco, monospace",
  "editor.fontLigatures": true,
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": "active",
  "editor.tabSize": 2,
  "editor.rulers": [
    80,
    120
  ],
  "editor.stickyScroll.enabled": true,
  "editor.semanticHighlighting.enabled": true,
  "editor.quickSuggestions": {
    "other": "on",
    "comments": "off",
    "strings": "on"
  },
  // ========== SYNTAX HIGHLIGHTING ==========
  "editor.tokenColorCustomizations": {
    "[One Dark Pro Darker]": {
      "textMateRules": [
        {
          "scope": [
            "support.type.property-name.json"
          ],
          "settings": {
            "foreground": "#f8ecf8"
          }
        },
        {
          "scope": [
            "entity.name.tag.tsx",
            "entity.name.tag.jsx"
          ],
          "settings": {
            "foreground": "#E5C07B"
          }
        },
        {
          "scope": [
            "meta.tag.attributes.tsx",
            "meta.tag.attributes.jsx"
          ],
          "settings": {
            "fontStyle": "italic bold",
            "foreground": "#271607"
          }
        }
      ]
    }
  },
  // ========== FORMATAÇÃO & LINTING ==========
  "editor.formatOnSave": true,
  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact"
  ],
  // Configurações Prettier (consolidadas)
  "prettier.singleQuote": true,
  "prettier.jsxSingleQuote": false,
  "prettier.bracketSameLine": false,
  "prettier.printWidth": 100,
  // Configurações por linguagem (otimizadas)
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit",
      "source.organizeImports": "explicit",
      "source.addMissingImports": "explicit"
    }
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit",
      "source.organizeImports": "explicit",
      "source.addMissingImports": "explicit"
    }
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit",
      "source.organizeImports": "explicit",
      "source.addMissingImports": "explicit"
    }
  },
  "[json]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "[vue]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.codeActionsOnSave": {
      "source.fixAll": "always"
    }
  },
  "[python]": {
    "editor.defaultFormatter": "ms-python.black-formatter",
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit"
    },
    "editor.tabSize": 4
  },
  // ========== PYTHON CONFIG ==========
  "python.formatting.provider": "black",
  "python.formatting.blackArgs": [
    "--line-length=88",
    "--skip-string-normalization"
  ],
  "python.analysis.autoImportCompletions": true,
  "python.analysis.autoSearchPaths": true,
  "python.analysis.diagnosticMode": "workspace",
  "python.analysis.typeCheckingMode": "basic",
  "python.linting.enabled": true,
  "python.linting.pylintEnabled": true,
  "python.testing.pytestEnabled": true,
  // ========== EMULAÇÃO JSX ==========
  "emmet.includeLanguages": {
    "javascript": "javascriptreact",
    "typescript": "typescriptreact"
  },
  // ========== HANDLING DE IMPORTS ==========
  "typescript.updateImportsOnFileMove.enabled": "always",
  "javascript.updateImportsOnFileMove.enabled": "always",
  "typescript.suggest.autoImports": true,
  "javascript.suggest.autoImports": true,
  // ========== ARQUIVOS / EXPLORER ==========
  "files.exclude": {
    "**/.git": true,
    "**/.DS_Store": true,
    "**/.next": true,
    "**/node_modules": false
  },
  "explorer.fileNesting.patterns": {
    "package.json": "*.lock, .env*, tsconfig.*, vite.config.*",
    "tsconfig.json": "tsconfig.*.json"
  },
  // ========== GIT ==========
  "git.enableSmartCommit": true,
  "git.confirmSync": false,
  "git.autofetch": true,
  // ========== PERFORMANCE ==========
  "typescript.tsserver.log": "off",
  // ========== SYNC DE CONFIGURAÇÕES ==========
  "syncSettings.resources": [
    "extensions",
    "keybindings",
    "settings",
    "snippets",
    "uiState"
  ],
  "syncSettings.ignoredExtensions": [],
  "syncSettings.ignoredSettings": [
    "editor.fontFamily"
  ],
  "syncSettings.keybindingsPerPlatform": true,
  "syncSettings.additionalFiles": [
    "~globalStorage/alefragnani.project-manager/projects.json"
  ],
  // ========== VERIFICAÇÃO ORTOGRÁFICA ==========
  "cSpell.language": "en, pt",
  "cSpell.userWords": [],
  // ========== SEGURANÇA ==========
  "security.workspace.trust.untrustedFiles": "open",
  // ========== EXTENSÕES ESPECÍFICAS ==========
  "database-client.autoSync": true,
  "tailwind-fold.autoFold": false,
  "editor.lineNumbers": "on",
  "editor.folding": false,
  "editor.matchBrackets": "never",
  "editor.renderLineHighlight": "none",
  "editor.selectionHighlight": false,
  "editor.occurrencesHighlight": "off",
}